# ── Mission Pipeline v3 — variables d'environnement ───────────────────────────
# Sur Mac : ces variables peuvent aussi vivre dans ~/.config/mission-pipeline/*.env
# (tous les fichiers *.env de ce dossier sont lus, format KEY=VALUE ; anthropic.env, airtable.env, gmail.env sont lus en premier, premier trouvé gagnant).
# Pour les quatre secrets, ces fichiers priment sur une variable exportée par le shell ; `mp doctor` dit d'où vient chacun.
# Sur GitHub Actions : déclarer les mêmes noms dans Settings → Secrets and variables.

# Secrets
ANTHROPIC_API_KEY=
AIRTABLE_PAT=                    # scopes : data.records:read/write, schema.bases:read (+ schema.bases:write pour `mp airtable-setup --apply`)
GMAIL_USER=xrobitaille92150@gmail.com
GMAIL_APP_PASSWORD=              # mot de passe d'application Google (16 caractères)
DIGEST_FROM=xro@xavier-robitaille.com
DIGEST_TO=xrobitaille92150@gmail.com

# Modèles Claude
MP_MODEL_MAIN=claude-opus-5-5    # scoring, retouches CV, lettre
MP_MODEL_FAST=claude-haiku-4-5   # classification des emails de statut

# Réglages
MP_SCORE_MIN=60                  # score minimal pour qu'une offre soit "actionnable"
MP_AUTO_DOSSIERS_PER_RUN=3       # dossiers générés automatiquement par run (les meilleures offres du jour)
MP_INGEST_DAYS=2                 # fenêtre de lecture Gmail (jours)
MP_EXPIRE_DAYS=30                # une offre sans décision depuis N jours passe « Expirée » (jamais scorée)
MP_LABEL_DONE=MissionPipeline    # label Gmail posé sur les emails traités

# Chemins (facultatif — valeurs par défaut relatives au dépôt)
# MP_CV_BASE_DIR=assets/cv_base
# MP_WRITING_RULES_DIR=assets/writing_rules
# MP_OUT_DIR=out
# MP_DRIVE_DOSSIERS_DIR=/Users/xavierrobitaille/Mon Drive/XavierAdvisory/10_Work/Candidatures/dossiers
