    },
    {
      "id": "Parser notes",
      "name": "Parser notes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        0
      ],
      "parameters": {
        "jsCode": "const rec = $('Prépa prompt notes').item.json;\nlet role = '', crit = '';\ntry {\n  const txt = ($json && $json.content && $json.content[0] && $json.content[0].text) || '';\n  const m = txt.match(/\\{[\\s\\S]*\\}/);\n  if (m) { const o = JSON.parse(m[0]); role = o.note_role || ''; crit = o.note_criteres || ''; }\n} catch (e) { /* laisse vide -> retente au prochain run */ }\nif (!role && !crit) return null;\nreturn { json: { id: rec.id, noteRole: role, noteCriteres: crit, preparer: rec.pertinence === 'Haute' } };",
        "mode": "runOnceForEachItem"
      }
    },
